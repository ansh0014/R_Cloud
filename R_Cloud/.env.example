# ==============================================================================
# R Agent Cloud - Unified Environment Variables Example (.env.example)
# ==============================================================================
# This file serves as a reference for configuring the environment variables
# across all microservices. Copy the relevant sections to a `.env` file 
# in each service's directory.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Auth Service (Directory: Backend/Auth)
# ------------------------------------------------------------------------------
# PORT: Port on which the Auth service runs (e.g., 8081 or 3000)
# DATABASE_URL: PostgreSQL connection string (e.g., Neon or local postgres)
# GOOGLE_CLIENT_ID: OAuth 2.0 Web application Client ID from Google Cloud Console
# UPSTASH_REDIS_REST_URL: REST URL for Upstash Redis server-side sessions
# UPSTASH_REDIS_REST_TOKEN: Authentication token for Upstash Redis REST API
# SESSION_NAME: Name of the session cookie (default: R_Cloud_Session)
# SESSION_TTL_SECONDS: Session lifetime in seconds (default: 604800 / 7 days)
# SESSION_COOKIE_SECURE: Set to true in production HTTPS environments (default: false)
# API_GATEWAY_URL: Base URL of the API Gateway (e.g., http://localhost:8080)
# FRONTEND_URL: Base URL of the Frontend client (e.g., http://localhost:5173)

AUTH_PORT=8081
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rcloud_auth?sslmode=disable
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
UPSTASH_SESSION_PREFIX=auth:session:
SESSION_NAME=R_Cloud_Session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
API_GATEWAY_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------------------------
# 2. API Gateway (Directory: Backend/api-gateway)
# ------------------------------------------------------------------------------
# PORT: Port on which the API Gateway runs (e.g., 8080)
# AUTH_SERVICE_URL: HTTP URL of the Auth service
# PROJECT_SERVICE_URL: HTTP URL of the Project service
# DEPLOYMENT_SERVICE_URL: HTTP URL of the Deployment service
# RUNTIME_SERVICE_URL: HTTP URL of the Runtime service
# AGENTOPS_SERVICE_URL: HTTP URL of the AgentOps service
# NATS_URL: URL of the NATS broker for message streaming
# FRONTEND_URL: Base URL of the Frontend client (CORS verification)
# JWT_SECRET: Secret key for verifying JWT tokens

GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://localhost:8081
PROJECT_SERVICE_URL=http://localhost:8082
DEPLOYMENT_SERVICE_URL=http://localhost:8083
RUNTIME_SERVICE_URL=http://localhost:8084
AGENTOPS_SERVICE_URL=http://localhost:8085
NATS_URL=nats://localhost:4222
JWT_SECRET=rcloud-super-secret-jwt-key


# ------------------------------------------------------------------------------
# 3. Project Service & GitHub Connection (Directory: Backend/project-service)
# ------------------------------------------------------------------------------
# PROJECT_SERVICE_PORT: Port on which the Project service runs (e.g., 8082)
# DATABASE_URL: PostgreSQL connection string
# GITHUB_TOKEN: GitHub Personal Access Token (classic) with `repo` scope
# GITHUB_CLIENT_ID: Client ID from your GitHub OAuth Application
# GITHUB_CLIENT_SECRET: Client Secret from your GitHub OAuth Application
# GITHUB_WEBHOOK_SECRET: Secret key used to verify payloads from GitHub Webhooks
# DEFAULT_BRANCH: Default branch name for repository operations (default: main)

PROJECT_SERVICE_PORT=8082
PROJECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rcloud_project?sslmode=disable
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
DEFAULT_BRANCH=main
GITHUB_REQUEST_TIMEOUT_SECONDS=10
SERVER_WRITE_TIMEOUT_SECONDS=15
SERVER_READ_TIMEOUT_SECONDS=15
SHUTDOWN_TIMEOUT_SECONDS=10


# ------------------------------------------------------------------------------
# 4. Deployment Service (Directory: Backend/deployment-service)
# ------------------------------------------------------------------------------
# PORT: Port on which the Deployment service runs (e.g., 8083)
# DATABASE_URL: PostgreSQL connection string
# NATS_URL: URL of the NATS broker
# RUNTIME_SERVICE_ADDR: Host and port of the Runtime gRPC Service
# VALIDATION_SERVICE_URL: HTTP URL of the static Validation Service
# AI_VALIDATION_AGENT_URL: HTTP URL of the AI Validation Agent
# PLANNER_SERVICE_URL: HTTP URL of the Planner / AgentOps service
# CLONE_BASE_DIR: Path to local directory where repository clones are stored
# GIT_TIMEOUT: Timeout for git clone/fetch operations

DEPLOYMENT_PORT=8083
DEPLOYMENT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rcloud_deployment?sslmode=disable
DEPLOYMENT_NATS_URL=nats://localhost:4222
RUNTIME_SERVICE_ADDR=localhost:50051
VALIDATION_SERVICE_URL=http://localhost:8086
AI_VALIDATION_AGENT_URL=http://localhost:8087
PLANNER_SERVICE_URL=http://localhost:8085
CLONE_BASE_DIR=./tmp/clones
GIT_TIMEOUT=60s


# ------------------------------------------------------------------------------
# 5. Validation Service (Directory: Backend/validation-service)
# ------------------------------------------------------------------------------
# PORT: Port on which the static Validation Service runs (e.g., 8086)

VALIDATION_PORT=8086
VALIDATION_SERVER_READ_TIMEOUT=15s
VALIDATION_SERVER_WRITE_TIMEOUT=30s
VALIDATION_SHUTDOWN_TIMEOUT=10s


# ------------------------------------------------------------------------------
# 6. AI Validation Agent (Directory: Ai-Agent/ai-validation-agent)
# ------------------------------------------------------------------------------
# PORT: Port on which the FastAPI validation agent runs (e.g., 8087)
# LLM_API_KEY: OpenAI or custom compatible LLM provider API key
# LLM_MODEL: Model version to use for validation advisory reports

AI_AGENT_PORT=8087
LLM_API_KEY=sk-proj-your-openai-api-key
LLM_MODEL=gpt-4-turbo-preview


# ------------------------------------------------------------------------------
# 7. Runtime Service (Directory: Backend/runtime-service)
# ------------------------------------------------------------------------------
# PORT: HTTP server port (e.g., 8084)
# GRPC_PORT: gRPC server port (e.g., 50051)
# DATABASE_URL: PostgreSQL connection string
# RAILWAY_API_TOKEN: Authentication token for provisioning containers on Railway
# NATS_URL: URL of the NATS broker

RUNTIME_PORT=8084
RUNTIME_GRPC_PORT=50051
RUNTIME_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rcloud_runtime?sslmode=disable
RAILWAY_API_TOKEN=your_railway_api_token
RUNTIME_NATS_URL=nats://localhost:4222


# ------------------------------------------------------------------------------
# 8. Frontend Web Dashboard (Directory: Frontend)
# ------------------------------------------------------------------------------
# VITE_API_GATEWAY_URL: Target URL of the API Gateway
# VITE_WS_URL: WebSocket entrypoint for the API Gateway
# VITE_GITHUB_CLIENT_ID: Client ID from your GitHub OAuth Application

VITE_API_GATEWAY_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback
